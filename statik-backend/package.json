{
  "name": "statik-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "build:railway": "npm run build",
    "start:railway": "npm run start",
    "setup": "npm ci --include=dev --no-audit --no-fund"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "helmet": "^6.0.1",
    "stripe": "^12.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0",
    "ts-node": "^10.9.1"
  },
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20 <21"
  }
}
